{
  "name": "arg-fpa-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Alliance Risk Group — AI-driven financial reporting dashboard. QuickBooks Online + HubSpot -> warehouse -> live dashboards, forecasting and an agent layer.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:visual": "tsx scripts/visual-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@electric-sql/pglite": "^0.5.4",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.50.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
