# Build scripts are approved explicitly, in package.json's pnpm.onlyBuiltDependencies.
#
# pnpm 10 refuses to run a dependency's postinstall unless it is named there. On a
# developer's machine that is a warning; on Vercel it is a failed deployment, and
# the two behaving differently is how an install that works locally breaks the
# build. This makes the local install fail exactly as CI does, so an unapproved
# build script is found by whoever added it rather than by the next deploy.
strict-dep-builds=true
