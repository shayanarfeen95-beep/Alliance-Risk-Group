# ---------------------------------------------------------------------------
# Alliance Risk Group — environment
#
# Nothing here is required to run locally. With DATABASE_URL unset the app runs
# on embedded PGlite (a real Postgres compiled to WASM) against ./.pgdata, so
# `pnpm db:migrate && pnpm db:seed && pnpm dev` works with zero infrastructure.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Set to a Postgres connection string in production (Neon). Leave unset for PGlite.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Demo mode. With DEMO_MODE=1 and DATABASE_URL unset, each instance brings up an
# in-memory Postgres, applies the migrations and loads the seed on first use, so
# the app is explorable before any database is provisioned. It is ephemeral —
# every instance holds its own copy and it resets on recycle — and the app says
# so on every page. Setting DATABASE_URL takes precedence and disables it.
# DEMO_MODE=1

# --- Session ---------------------------------------------------------------
# 32+ byte secret signing the session JWT. Generate: openssl rand -base64 48
AUTH_SECRET=dev-only-insecure-secret-change-me-before-any-real-deployment

# --- Agent layer -----------------------------------------------------------
# OpenRouter serves the assistant. Without a key every dashboard, export and
# control still works and every tool is callable and tested; only the
# conversational layer is unavailable, and it says so.
#
# The model MUST support tool calling. The assistant is nothing but tool calls,
# and a model without them does not fail visibly: it answers from its own
# weights, fluently, with figures that came from nowhere.
#
# The default is z-ai/glm-5.2:free. That default carries real risk and it is
# worth naming: the free tier changes, and the day this model is withdrawn or
# loses tool support the failure will be silent. Admin -> Assistant re-checks it
# against OpenRouter's live catalogue — run that whenever the assistant starts
# behaving oddly.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=z-ai/glm-5.2:free

# --- QuickBooks Online (read-only) -----------------------------------------
# Spec Rule 7: we never write back to QBO. These scopes are read-only.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REALM_ID=
# QBO_REFRESH_TOKEN=
# QBO_ENVIRONMENT=production          # or 'sandbox'

# --- HubSpot (read-only private app) ---------------------------------------
# HUBSPOT_ACCESS_TOKEN=
# Confirmed in Sprint 1 (open item #2). Until set, sales/marketing KPIs report
# at ARG Total only rather than inventing an attribution rule.
# HUBSPOT_DIVISION_PROPERTY=

# --- Google Sheets (read-only) ---------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_BUDGET_SPREADSHEET_ID=

# --- Feature flags ---------------------------------------------------------
# Open item #1: does ARG class its balance sheet in QBO? When false, DSO/DPO/
# CCC/Cash Runway are ARG-Total-only and are labeled as such (Defect 2).
BALANCE_SHEET_CLASSED=true

# Cron authentication for the overnight refresh endpoint, /api/cron/refresh.
# Without it the endpoint refuses rather than running open to the internet — an
# unset variable must never be the permissive case.
#   openssl rand -base64 32
# CRON_SECRET=

# --- Database -------------------------------------------------------------
# Any Postgres works. Neon is the recommended host on Vercel: serverless,
# generous free tier, and it runs this schema unchanged — the triggers, CHECK
# constraints and plpgsql that hold the forecast-immutability and ARG-Total
# guarantees are Postgres features, not application code.
#
# Use Neon's POOLED connection string (the one containing "-pooler"). The app
# sets prepare:false, which pgbouncer in transaction mode requires.
#
# Migrations apply themselves on first request, guarded by a Postgres advisory
# lock so concurrent cold starts cannot race. The first visit then offers a
# setup screen to create the first administrator.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Source credentials ---------------------------------------------------
# Required before any source can be connected from the UI. Credentials are
# encrypted with AES-256-GCM before they reach the database; without this the
# app refuses to store them rather than writing a token in the clear.
#   openssl rand -base64 32
# CREDENTIAL_KEY=

# QuickBooks Online. Create an app at developer.intuit.com and register
#   https://<your-domain>/api/connect/qbo/callback
# as a redirect URI. Users then click Connect in Admin — no token handling.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=production        # or "sandbox"

# HubSpot. Either an OAuth app (one-click Connect) or a private-app token
# pasted into Admin, which is simpler for a single portal.
#
# The private app needs crm.objects.deals.read and crm.objects.contacts.read at
# minimum. crm.objects.owners.read adds salesperson names and the owner filter;
# crm.objects.meetings.read adds Meetings Completed. Each is checked against
# HubSpot before the token is stored, and a missing one is named.
#
# It does NOT need the `oauth` scope. That scope only reveals the portal number
# for the label on the admin card, and asking for it as a validity check is what
# made valid tokens report as rejected.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Google Sheets uses a service account, pasted in Admin. Share the spreadsheet
# with the service account's email address; the credential is verified by
# actually reading the sheet before it is saved.

# --- Composio (optional) ---------------------------------------------------
# An alternative way to connect QuickBooks and HubSpot: Composio hosts the
# OAuth dance, so nobody has to register an app at developer.intuit.com. Set
# these and a "Connect with Composio" button appears on those two cards.
#
# Read this before choosing it. The connection Composio holds is
# WRITE-CAPABLE — its HubSpot toolkit includes HUBSPOT_UPDATE_DEALS. This
# codebase never names a write slug, so Rule 7 still holds the same way it does
# everywhere else (by there being no code that could), but a direct HubSpot
# private-app token scoped to the four read scopes is a stronger guarantee, and
# stays the recommendation where you have the choice. ARG's financial data also
# passes through a third party, which is ARG's decision to make and not a
# default anyone should be opted into.
#
# Create one auth config per toolkit in the Composio dashboard and paste its id.
# COMPOSIO_API_KEY=ak_...
# COMPOSIO_AUTH_CONFIG_QUICKBOOKS=ac_...
# COMPOSIO_AUTH_CONFIG_HUBSPOT=ac_...
# Scopes the connection at Composio's end. The company's books, not a person —
# it must keep working when whoever clicked Connect leaves.
# COMPOSIO_USER_ID=alliance-risk-group

# Only needed when the deployment sits behind a domain the request does not
# reveal (a proxy, a custom domain). OAuth providers require an exact match.
# OAUTH_REDIRECT_BASE=https://arg-financial-reporting.vercel.app
